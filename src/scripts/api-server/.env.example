# RE7 API server configuration. Copy to .env (git-ignored). Never commit secrets.

# --- Auth store (SQLite, local to this server/container) ---
API_AUTH_DB=./data/auth.sqlite

# --- RE7 billing DB (remote target, used by re7-lib; least-privilege role) ---
RE7_DB_HOST=127.0.0.1
RE7_DB_PORT=5432
RE7_DB_NAME=rate_engine
RE7_DB_USER=rt_api
RE7_DB_PASS=change_me

# --- JWT ---
# generate: openssl rand -base64 32
JWT_SECRET=change_me
JWT_ALG=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=28800
