# Secrets for the docker stack. Copy to docker/.env (git-ignored) and set real
# values. `docker compose` auto-loads docker/.env. NEVER commit docker/.env.

# re7-db Postgres password (role 're_admin'). The clients below MUST use the
# same value to reach re7-db.
POSTGRES_PASSWORD=change_me
RE7_DB_PASS=change_me

# API server. Leave JWT_SECRET blank to auto-generate a strong one on start,
# or set a fixed value of >=32 chars (openssl rand -base64 32).
JWT_SECRET=
API_ADMIN_USER=admin
API_ADMIN_PASS=change_me
